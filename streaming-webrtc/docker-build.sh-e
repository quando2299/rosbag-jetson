#!/bin/bash

echo "=== Building MQTT WebRTC Streaming Docker Image ==="

# Detect architecture
ARCH=$(uname -m)
echo "Detected architecture: $ARCH"

# Set platform
if [ "$ARCH" = "x86_64" ]; then
    PLATFORM="linux/amd64"
elif [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
    PLATFORM="linux/arm64"
else
    echo "❌ Unsupported architecture: $ARCH"
    exit 1
fi

echo "Building for platform: $PLATFORM"

# Build Docker image
docker build \
    --platform $PLATFORM \
    -t mqtt-webrtc-streaming:latest \
    .

if [ $? -eq 0 ]; then
    echo "✅ Docker image built successfully!"
    echo "Image: mqtt-webrtc-streaming:latest"
    echo ""
    echo "To run the container:"
    echo "  ./docker-run.sh"
else
    echo "❌ Docker build failed!"
    exit 1
fi